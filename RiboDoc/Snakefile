        rm {params.tmp_file_threeprime} 2> {log.rm}

        echo -e "id\tname\t{wildcards.sample}" 2>> {log.echo} > {output.htseq_table_fiveprime}
        htseq-count \
            -n {threads} \
            -f bam \
            -t {params.fiveprime_feature} \
            -i {params.parent_attribut} \
            --additional-attr {params.htseq_additional} \
            -m intersection-strict \
            --nonunique fraction \
            {input.bam} {input.gff} \
            2>> {log.htseqcount} > {params.tmp_file_fiveprime}

        head -n -5 {params.tmp_file_fiveprime} 2>> {log.head} | \
            awk -F '\t+' '{{if($3 >= 0) {{print($0)}} else {{printf("%s\\tNA\\t%s\\n",$1,$2)}}}}' 2>> {log.awk} >> {output.htseq_table_fiveprime}

        rm {params.tmp_file_fiveprime} 2>> {log.rm}
        """

