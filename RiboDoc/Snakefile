                    local_path + "RESULTS/bowtie2_depletion/{sample}_R1.fastq.gz"
                    if not config["skip_depletion"] and not config["skip_trimming"] and config["depletion_tool"] == "bowtie2"
                    else find_fastq_path(wildcards)[0]
                )
            )
        ),
        r2    = lambda wildcards: (
            local_path + "RESULTS/trimgalore/{sample}_R2_trimgalore.fastq.gz"
            if is_paired(wildcards.sample, checkpoints.check_samplesheet.get(**wildcards).output[0])
            and config["skip_depletion"] and not config["skip_trimming"] and config["trimmer"] == "trimgalore"
