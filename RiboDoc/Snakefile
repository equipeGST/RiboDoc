def hisat2_align_outputs(wildcards):
    if config["aligner"] != "hisat2":
        return []
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    result = []
    for sample in get_sample(wildcards):
        # r1 is always .1.gz (hisat2 rule always produces it)
        result.append(local_path + "RESULTS/hisat2/{sample}.notAlign.R1.fastq.gz")
        if is_paired(sample, checkpoint_output):
            result.append(local_path + "RESULTS/hisat2/{sample}.notAlign.R2.fastq.gz")
    return result

def bowtie2_align_outputs(wildcards):
    if config["aligner"] != "bowtie2":
        return []
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    result = []
    for sample in get_sample(wildcards):
        result.append(local_path + "RESULTS/bowtie2/{sample}.notAlign.R1.fastq.gz")
        if is_paired(sample, checkpoint_output):
            result.append(local_path + "RESULTS/bowtie2/{sample}.notAlign.R2.fastq.gz")
    return result

