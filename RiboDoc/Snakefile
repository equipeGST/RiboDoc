rule count_matrix_creation:
    input:
        transcript_list = local_path + "RESULTS/DESeq2_" + config['gff_cds_feature'] + "/names_correspondence_list.csv",
        htseq_cds       = lambda wildcards: htseq_cds_outputs(wildcards),
        htseq_utr       = lambda wildcards: htseq_utr_outputs(wildcards) if config['UTR'] == "yes" else []
    output:
        counts_matrix = local_path + "RESULTS/DESeq2_" + config['gff_cds_feature'] + "/{sample_type}/count_matrix_by_transcript_IDs.csv"
    log:
        cut      = logs_path + "count_matrix_creation/{sample_type}/cut.log",
        cat_cds  = logs_path + "count_matrix_creation/{sample_type}/cat.log",
        join_utr = logs_path + "count_matrix_creation/{sample_type}/join_utr.log"
    benchmark:
        local_path + "benchmarks/count_matrix_creation/{sample_type}/count_matrix_creation.benchmark.txt"
    params:
        tmp_file    = local_path + "RESULTS/tmp_count_matrix_{sample_type}.txt",
        htseq_dir   = local_path + "RESULTS/htseq_count/",
        features_of_interest = (
            [config['gff_cds_feature']] +
            ([config['gff_5UTR_feature'], config['gff_3UTR_feature']] if config['UTR'] == "yes" else [])
        )
    run:
        # checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
        # samples = []
        samples = get_samples_by_type(wildcards, wildcards.sample_type)
        name_in_gff = config['gff_name_attribut'] != ''
        fields = "1,3" if name_in_gff else "1,2"
        for region in params.features_of_interest:
            region_matrix = params.htseq_dir + "tmp_" + wildcards.sample_type + "_" + region + "_count_matrix.csv"
            shell("cut -f 1 {input.transcript_list} 2> {log.cut} > " + region_matrix)
            for sample in samples:
                htseq_file = params.htseq_dir + sample + "." + region + ".tsv"
                shell(
                    "cut -f " + fields + " " + htseq_file +
                    " | LC_COLLATE=C join --header -t $'\\t' " + region_matrix +
                    " - > {params.tmp_file} 2>> {log.cut} && " +
                    "cat {params.tmp_file} > " + region_matrix + " 2> {log.cat_cds}"
                )
            shell("LC_COLLATE=C join --header -t $'\t' {params.tmp_file} {input.transcript_list} 1> " + region_matrix + " 2> {log.join_utr}")
            if region == params.features_of_interest[0]:
                shell("cp " + region_matrix + " {output.counts_matrix}")
        shell("rm -f {params.tmp_file}")

rule name_attribute_GFF:
    input:
        gff = lambda wildcards: get_gff(wildcards),
    output:
        gff_namedCDS = local_path + "RESULTS/annex_database/NamedCDS_{gff_basename}",
    params:
        gff_basename    = lambda wildcards: os.path.splitext(os.path.basename(get_gff(wildcards)))[0],
        name_in_gff     = True if config['gff_name_attribut'] != '' else False,
        name_attribute  = config['gff_name_attribut']
    run:
        gene_id_bool = True
        if params.name_in_gff == True:
            db = gffutils.create_db(input.gff, ':memory:', merge_strategy='create_unique', keep_order=True)
            with open(output.gff_namedCDS, 'w') as fout:
                for d in db.directives:
                    fout.write('##{0}\n'.format(d))
                for feature in db.all_features():
                    if feature.featuretype in features_of_interest or feature.featuretype == 'exon':
                        parent = list(db.parents(feature, level=1))
                        if len(parent) > 0:
                            parent = parent[0]
                            if parent.attributes.get(params.name_attribute) and not feature.attributes.get(params.name_attribute):
                                feature.attributes[params.name_attribute] = [i.replace("mRNA","cds") for i in parent.attributes.get(params.name_attribute)]
                                feature.attributes[params.name_attribute][0] + "_name"
                            if parent.attributes.get('ID') and not feature.attributes.get('ID'):
                                feature.attributes["ID"] = parent.attributes["ID"]
                                feature.attributes['ID'] = feature.attributes['ID'][0] + "_CDS"
                            if parent.attributes.get('ID') and not parent.attributes.get(params.name_attribute):
                                feature.attributes[params.name_attribute] = parent.attributes["ID"]
                                feature.attributes[params.name_attribute][0] + "_name"
                        if feature.attributes.get(params.name_attribute):
                            fout.write(str(feature) + ';\n')
                    else:
                        fout.write(str(feature) + '\n')
        else:
            shell("cp {input.gff} {output.gff_namedCDS}")
        if gene_id_bool:
            print("'gene_id' attributes are present.")
        else:
            print("Missing at least some 'gene_id' attribute in this gff.")
        shell("sed -i -E 's/\\s/\\t/8' {output.gff_namedCDS}")
        shell('sed -i -E "s/\\"//g" {output.gff_namedCDS}')

