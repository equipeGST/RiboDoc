            2> {log}
        """

rule clean_annotation:
    input:
        gff = lambda wildcards: get_gff(wildcards)
    output:
        filtered_gff = local_path + "RESULTS/annex_database/{fasta_basename}.clean.gtf"
    log:
        logs_path + "clean_annotation/{fasta_basename}.log"
    benchmark:
        local_path + "benchmarks/clean_annotation/{fasta_basename}.benchmark.txt"
    threads:
        multi_threads_nbr
    params:
        fasta_basename = lambda wildcards: os.path.splitext(os.path.basename(get_fasta(wildcards)))[0]
    shell:
        """
        gffread {input.gff} \
            --keep-exon-attrs \
            -F \
            -T \
            -o {output.filtered_gff} 2> {log}
        """

rule rsem_generate_reference:
    input:
        fasta        = lambda wildcards: get_fasta(wildcards),
        filtered_gff = lambda wildcards: local_path + "RESULTS/annex_database/" + os.path.splitext(os.path.basename(get_gff(wildcards)))[0] + ".clean.gtf"
    output:
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.chrlist",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.grp",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.idx.fa",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.n2g.idx.fa",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.seq",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.ti",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.transcripts.fa"
    log:
        logs_path + "rsem/{fasta_basename}_rsem_reference.log"
    benchmark:
        local_path + "benchmarks/rsem/{fasta_basename}_rsem_reference.benchmark.txt"
    threads:
        multi_threads_nbr
    params:
        index_dir = local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome",
    shell:
        """
        if [[ {input.filtered_gff} == *.gtf ]]; then
            gff_format="--gtf"
        else
            gff_format="--gff3"
        fi

        rsem-prepare-reference \
            ${{gff_format}} {input.filtered_gff} \
            --num-threads {threads} \
            {input.fasta} {params.index_dir} &> {log}
        """

rule STAR_align_transcriptome:
