            -S {output.sam} 2>> {log} ;
        """

rule samtools:
    input:
        sam_hisat2  = local_path + "RESULTS/hisat2/{sample}.hisat2.sam" if config["aligner"] in ["both", "hisat2"] else [],
        sam_bowtie2 = local_path + "RESULTS/bowtie2/{sample}.bowtie2.sam" if config["aligner"] in ["both", "bowtie2"] else []
    output:
        bam = local_path + "RESULTS/BAM/{sample}.bam"
    log:
        view_header = logs_path + "samtools_filter/{sample}.grep.log",
        view_core   = logs_path + "samtools_filter/{sample}.grep_core.log",
        ZS_filter   = logs_path + "samtools_filter/{sample}.NH_filter.log",
        XS_filter   = logs_path + "samtools_filter/{sample}.XS_filter.log",
        XM_filter   = logs_path + "samtools_filter/{sample}.XM_filter.log",
        view_bam    = logs_path + "samtools_filter/{sample}.view_bam.log",
        sort_bam    = logs_path + "samtools_filter/{sample}.sort_bam.log",
        rm          = logs_path + "samtools_filter/{sample}.rm.log"
    benchmark:
        local_path + "benchmarks/samtools_filter/{sample}.benchmark.txt"
    resources:
        mem_mb = round(mem_mb_resources / 3)
    params:
        sam = local_path + "RESULTS/" + folder_alignment + "/{sample}.sam"
    threads:
        multi_threads_nbr
    shell:
        """
        if [ -z {input.bowtie2} ];
        then
            samtools view \\
                -H {input.sam_hisat2} \\
                2> {log.view_header} \\
                1> {params.sam} ;

            samtools view {input.sam_hisat2} 2> {log.view_core} | \\
                grep -v 'ZS:i:' 2> {log.ZS_filter} | \\
                egrep -vi 'XM:i:[2-9]' 2> {log.XM_filter} \\
                1>> {params.sam} ;
        elif [ -z {input.hisat2} ];
        then
            samtools view \\
                -H {input.sam_bowtie2} \\
                2> {log.view_header} \\
                1> {params.sam} ;
            
            grep -v 'XS:i:' {input.sam_bowtie2} 2> {log.XS_filter} | \\
                egrep -vi 'XM:i:[2-9]' \\
                2>> {log.XM_filter} \\
                1>> {params.sam} ;
        else
            samtools view \\
                -H {input.sam_hisat2} \\
                2> {log.view_header} \\
                1> {params.sam} ;

            samtools view {input.sam_hisat2} 2> {log.view_core} | \\
                grep -v 'ZS:i:' 2> {log.ZS_filter} | \\
                egrep -vi 'XM:i:[2-9]' 2> {log.XM_filter} \\
                1>> {params.sam} ;
            
            grep -v 'XS:i:' {input.sam_bowtie2} 2> {log.XS_filter} | \\
                egrep -vi 'XM:i:[2-9]' \\
                2>> {log.XM_filter} \\
                1>> {params.sam} ;
        fi

        samtools view -@ {threads} -F 3844 -q 1 -h -b {params.sam} 2> {log.view_bam} | \\
            samtools sort -@ {threads} -o {output.bam} \\
            2> {log.sort_bam} ;

        rm -rf {params.sam} 2> {log.rm} ;
        """

rule STAR_align:
    input:
        index = lambda wildcards: local_path + "RESULTS/annex_database/index/STAR/" + os.path.splitext(os.path.basename(get_fasta(wildcards)))[0] + "/genomeParameters.txt",
        r1      = local_path + "RESULTS/trimgalore/{sample}_R1_trimgalore.fastq.gz" if config["skip_depletion"] == True else local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R1.fastq.gz", 
        r2      = (
            local_path + "RESULTS/trimgalore/{sample}_R2_trimgalore.fastq.gz"
            if config['paired_end'] and config["skip_depletion"]
            else (
                local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R2.fastq.gz"
                if config['paired_end'] and not config["skip_depletion"]
                else []))
    output:
        bam = local_path + "RESULTS/" + folder_alignment + "/{sample}.bam"
    log:
        err = logs_path + "STAR/{sample}_align.err",
        out = logs_path + "STAR/{sample}_align.out"
    benchmark:
        local_path + "benchmarks/STAR/{sample}.benchmark.txt"
    params:
        index_dir   = lambda wildcards: local_path + "RESULTS/annex_database/index/STAR/" + os.path.splitext(os.path.basename(get_fasta(wildcards)))[0] + "/",
        out_dir     = local_path + "RESULTS/STAR/",
        prefix      = "{sample}_",
        tmp_dir     = local_path + "RESULTS/STAR/{sample}_tmp/"
    threads:
        multi_threads_nbr
    shell:
        """
        if [ ! -d {params.out_dir} ];
        then
            mkdir -p {params.out_dir}
        fi

        if [ -n "{input.r2}" ]; then
            reads="{input.r1} {input.r2}"
        else
            reads="{input.r1}"
        fi
        STAR \\
            --genomeDir {params.index_dir} \\
            --outFileNamePrefix {params.out_dir}{params.prefix} \\
            --outSAMtype BAM SortedByCoordinate \\
            --readFilesCommand zcat \\
            --readFilesIn ${{reads}} \\
            --runThreadN {threads} \\
            1> {log.out} 2> {log.err} ;
        
        cat {params.out_dir}{params.prefix}Log.out 1>> {log.out} 2>> {log.err} ;
        cat {params.out_dir}{params.prefix}Log.final.out  1>> {log.out} 2>> {log.err} ;
        cat {params.out_dir}{params.prefix}Log.progress.out 1>> {log.out} 2>> {log.err} ;
        rm {params.out_dir}{params.prefix}Log*out 2>> {log.err}
        mv {params.out_dir}{params.prefix}Aligned.sortedByCoord.out.bam {output.bam} 2>> {log.err} 1>> {log.out}
        """

rule STAR_index_transcriptome:
    input:
        fasta   = lambda wildcards: get_fasta(wildcards),
        gff     = lambda wildcards: get_gff(wildcards)
        # gff     = lambda wildcards: local_path + "RESULTS/annex_database/index/rsem/" + os.path.splitext(os.path.basename(get_fasta(wildcards)))[0] + ".gtf",
        # fasta   = lambda wildcards: local_path + "RESULTS/annex_database/index/rsem/" + os.path.splitext(os.path.basename(get_fasta(wildcards)))[0] + ".transcripts.fa"
    output:
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/chrLength.txt",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/chrName.txt",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/chrStart.txt",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/chrNameLength.txt",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genomeParameters.txt",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/SAindex",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/SA",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/Log.out"
    log:
        logs_path + "STAR/{fasta_basename}_transcripts_index.log"
    benchmark:
        local_path + "benchmarks/STAR/{fasta_basename}_transcripts_index.benchmark.txt"
    params:
        index_dir       = local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts",
        fasta_basename  = lambda wildcards: os.path.splitext(os.path.basename(get_fasta(wildcards)))[0]
    threads:
        multi_threads_nbr
    shell:
        """
        if [ ! -d {params.index_dir} ];
        then
            mkdir -p {params.index_dir}
        fi
        STAR \\
            --runMode genomeGenerate \\
            --genomeDir {params.index_dir} \\
            --genomeFastaFiles {input.fasta} \\
            --sjdbGTFfile {input.gff} \\
            --runThreadN {threads} \\
            --outFileNamePrefix {params.index_dir}/{params.fasta_basename}. \\
            2> {log}
        """

rule clean_annotation:
    input:
        gff = lambda wildcards: get_gff(wildcards)
    output:
        filtered_gff = local_path + "RESULTS/annex_database/{fasta_basename}.clean.gtf"
    log:
        logs_path + "clean_annotation/{fasta_basename}.log"
    benchmark:
        local_path + "benchmarks/clean_annotation/{fasta_basename}.benchmark.txt"
    threads:
        multi_threads_nbr
    params:
        fasta_basename  = lambda wildcards: os.path.splitext(os.path.basename(get_fasta(wildcards)))[0]
    shell:
        """
        gffread {input.gff} \
            --keep-exon-attrs \
            -F \
            -T \
            -o {output.filtered_gff} 2> {log}
        """

rule rsem_generate_reference:
    input:
        fasta           = lambda wildcards: get_fasta(wildcards),
        filtered_gff    = lambda wildcards: local_path + "RESULTS/annex_database/" + os.path.splitext(os.path.basename(get_gff(wildcards)))[0] + ".clean.gtf"
    output:
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.chrlist",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.grp",
        # local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.gtf",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.idx.fa",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.n2g.idx.fa",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.seq",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.ti",
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome.transcripts.fa"
    log:
        logs_path + "rsem/{fasta_basename}_rsem_reference.log"
    benchmark:
        local_path + "benchmarks/rsem/{fasta_basename}_rsem_reference.benchmark.txt"
    threads:
        multi_threads_nbr
    params:
        index_dir = local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/genome",
    shell:
        """
        if [[ {input.filtered_gff} == *.gtf ]]
        then
            gff_format="--gtf"
        else
            gff_format="--gff3"
        fi

        rsem-prepare-reference \\
            ${{gff_format}} {input.filtered_gff} \\
            --num-threads 10 \\
            {input.fasta} {params.index_dir} &> {log}
        """

rule STAR_align_transcriptome:
    input:
        gff     = lambda wildcards: local_path + "RESULTS/annex_database/" + os.path.splitext(os.path.basename(get_gff(wildcards)))[0] + ".clean.gtf",
        # gff     = lambda wildcards: local_path + "RESULTS/annex_database/{fasta_basename}.clean.gtf",
        index   = lambda wildcards: local_path + "RESULTS/annex_database/index/rsem/" + os.path.splitext(os.path.basename(get_fasta(wildcards)))[0] + "_transcripts/genomeParameters.txt",
        r1      = local_path + "RESULTS/trimgalore/{sample}_R1_trimgalore.fastq.gz" if config["skip_depletion"] == True else local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R1.fastq.gz", 
        r2      = (
            local_path + "RESULTS/trimgalore/{sample}_R2_trimgalore.fastq.gz"
            if config['paired_end'] and config["skip_depletion"]
            else (
                local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R2.fastq.gz"
                if config['paired_end'] and not config["skip_depletion"]
                else []))
    output:
        bam = local_path + "RESULTS/" + folder_alignment + "_transcripts/{sample}.transcripts.bam"
    log:
        err = logs_path + "STAR/{sample}_align_transcripts.err",
        out = logs_path + "STAR/{sample}_align_transcripts.out"
    benchmark:
        local_path + "benchmarks/STAR/{sample}.benchmark_transcripts.txt"
    params:
        out_dir     = local_path + "RESULTS/STAR/",
        prefix      = "{sample}_transcripts.",
        tmp_dir     = local_path + "RESULTS/STAR/{sample}_tmp/",
        index       = lambda wildcards: local_path + "RESULTS/annex_database/index/rsem/" + os.path.splitext(os.path.basename(get_fasta(wildcards)))[0] + "_transcripts/",
    threads:
        multi_threads_nbr
    shell:
        """
        if [ ! -d {params.out_dir} ];
        then
            mkdir -p {params.out_dir}
        fi

        if [ -n "{input.r2}" ]; then
            reads="{input.r1} {input.r2}"
        else
            reads="{input.r1}"
        fi

        STAR \\
            --quantMode TranscriptomeSAM \\
            --genomeDir {params.index} \\
            --outFileNamePrefix {params.out_dir}{params.prefix} \\
            --sjdbGTFfile {input.gff} \\
            --readFilesCommand zcat \\
            --readFilesIn ${{reads}} \\
            --runThreadN {threads} \\
            --outSAMtype BAM Unsorted \\
            --twopassMode Basic \\
            --alignEndsType EndToEnd \\
            --outFilterMultimapNmax 10 \\
            --alignSJDBoverhangMin 1 \\
            --outSAMattributes All \\
            --outSAMstrandField intronMotif \\
            # --outSAMattributes NH HI AS NM MD \\
            # --outFilterMultimapNmax 20 \\
            # --outSAMunmapped Within \\
            # --outFilterMismatchNoverReadLmax 0.04 \\
            # --alignIntronMin 20 \\
            # --alignIntronMax 1000000 \\
            # --alignMatesGapMax 1000000 \\
            1> {log.out} 2> {log.err} ;
        
        cat {params.out_dir}{params.prefix}Log.out 1>> {log.out} 2>> {log.err} ;
        cat {params.out_dir}{params.prefix}Log.final.out  1>> {log.out} 2>> {log.err} ;
        cat {params.out_dir}{params.prefix}Log.progress.out 1>> {log.out} 2>> {log.err} ;
        rm {params.out_dir}{params.prefix}Log*out 2>> {log.err}
        mv {params.out_dir}{params.prefix}Aligned.toTranscriptome.out.bam {output.bam} 2>> {log.err} 1>> {log.out}
        """

