rule STAR_index:
    input:
        fasta = lambda wildcards: get_fasta(wildcards)
    output:
        local_path + "RESULTS/annex_database/index/STAR/{fasta_basename}/chrLength.txt",
        local_path + "RESULTS/annex_database/index/STAR/{fasta_basename}/chrName.txt",
        local_path + "RESULTS/annex_database/index/STAR/{fasta_basename}/chrStart.txt",
        local_path + "RESULTS/annex_database/index/STAR/{fasta_basename}/chrNameLength.txt",
        local_path + "RESULTS/annex_database/index/STAR/{fasta_basename}/genomeParameters.txt",
        local_path + "RESULTS/annex_database/index/STAR/{fasta_basename}/SAindex",
        local_path + "RESULTS/annex_database/index/STAR/{fasta_basename}/SA",
        local_path + "RESULTS/annex_database/index/STAR/{fasta_basename}/Log.out"
    log:
        logs_path + "STAR/{fasta_basename}_index.log"
    benchmark:
        local_path + "benchmarks/STAR/{fasta_basename}_index.benchmark.txt"
    params:
        index_dir       = local_path + "RESULTS/annex_database/index/STAR/{fasta_basename}/",
        fasta_basename  = lambda wildcards: os.path.splitext(os.path.basename(get_fasta(wildcards)))[0]
    threads:
        multi_threads_nbr
    shell:
        """
        if [ ! -d {params.index_dir} ];
        then
            mkdir -p {params.index_dir}
        fi
            STAR \\
            --runMode genomeGenerate \\
            --genomeDir {params.index_dir} \\
            --genomeFastaFiles {input.fasta} \\
            --runThreadN {threads} \\
            --outFileNamePrefix {params.index_dir} 
            2> {log}
        """

