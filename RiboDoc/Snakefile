rule hisat2_align:
    input:
        index = lambda wildcards: local_path + "RESULTS/annex_database/index/hisat2/{fasta_basename}.fa",
        r1    = lambda wildcards: (local_path + "RESULTS/trimgalore/{sample}_R1_trimgalore.fastq.gz" 
            if config["skip_depletion"] and not config["skip_trimming"] and config["trimmer"] == "trimgalore"
            else (
                local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R1.fastq.gz"
                if not config["skip_depletion"] and config["depletion_tool"] == "sortMeRNA"
                else (
                    local_path + "RESULTS/bowtie2_depletion/{sample}_R1.fastq.gz"
                    if not config["skip_depletion"] and config["depletion_tool"] == "bowtie2"
                    else find_fastq_path(wildcards)[0]))),
        r2    = lambda wildcards: (
            local_path + "RESULTS/trimgalore/{sample}_R2_trimgalore.fastq.gz"
            if is_paired(wildcards.sample,
                checkpoints.check_samplesheet.get(**wildcards).output[0]) 
                and config["skip_depletion"] and not config["skip_trimming"] and config["trimmer"] == "trimgalore"
            else (
                local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R2.fastq.gz"
                if is_paired(wildcards.sample,
                    checkpoints.check_samplesheet.get(**wildcards).output[0])
                    and not config["skip_depletion"] and config["depletion_tool"] == "sortMeRNA"
                else(
                    find_fastq_path(wildcards)[1] 
                    if is_paired(wildcards.sample, checkpoints.check_samplesheet.get(**wildcards).output[0])
                    and config["skip_depletion"] and config["skip_trimming"]
                    else(
                        local_path + "RESULTS/bowtie2_depletion/{sample}_R2.fastq.gz"
                        if is_paired(wildcards.sample, checkpoints.check_samplesheet.get(**wildcards).output[0])
                        and not config["skip_depletion"] and config["depletion_tool"] == "bowtie2"
                        else []
                    )
                )
            )
        )
    output:
        r1  = local_path + "RESULTS/hisat2/{sample}.notAlign.R1.fastq.gz",
        r2  = local_path + "RESULTS/hisat2/{sample}.notAlign.R2.fastq.gz",
        sam = local_path + "RESULTS/hisat2/{sample}.hisat2.sam"
    log:
        logs_path + "hisat2/{sample}_align.log"
    benchmark:
        local_path + "benchmarks/hisat2/{sample}_align.benchmark.txt"
    params:
        fasta_basename   = lambda wildcards: os.path.splitext(os.path.basename(get_fasta(wildcards)))[0],
        unaligned_prefix = local_path + "RESULTS/hisat2/{sample}.notAlign.R%.fastq.gz",
        paired           = lambda wildcards: is_paired(
            wildcards.sample,
            checkpoints.check_samplesheet.get(**wildcards).output[0]
        )
    threads:
        multi_threads_nbr
    shell:
        """
        if [ "{params.paired}" = "True" ]; then
            reads="-1 {input.r1} -2 {input.r2}"
            out_reads="--un-conc-gz {params.unaligned_prefix}"
        else
            reads="-U {input.r1}"
            out_reads="--un-gz {params.unaligned_prefix}.1.gz"
        fi

        hisat2 \
            -x {input.index} \
            --threads {threads} \
            --no-softclip \
            --no-unal \
            ${{reads}} \
            ${{out_reads}} \
            -S {output.sam} 2>> {log}

        if [ "{params.paired}" = "False" ]; then
            touch {output.r2}
        fi
        """

rule bowtie2_align:
    input:
        index = local_path + "RESULTS/annex_database/index/bowtie2/{fasta_basename}.fa",
        r1    = local_path + "RESULTS/hisat2/{sample}.notAlign.R1.fastq.gz",
        r2    = lambda wildcards: (
            local_path + "RESULTS/hisat2/{sample}.notAlign.R2.fastq.gz"
            if is_paired(wildcards.sample,
                checkpoints.check_samplesheet.get(**wildcards).output[0])
            else []
        )
    output:
        r1  = local_path + "RESULTS/bowtie2/{sample}.notAlign.R1.fastq.gz",
        r2  = local_path + "RESULTS/bowtie2/{sample}.notAlign.R2.fastq.gz",
        sam = local_path + "RESULTS/bowtie2/{sample}.bowtie2.sam"
    log:
        logs_path + "bowtie2/{sample}_align.log"
    benchmark:
        local_path + "benchmarks/bowtie2/{sample}_align.benchmark.txt"
    params:
        fasta_basename   = lambda wildcards: os.path.splitext(os.path.basename(get_fasta(wildcards)))[0],
        unaligned_prefix = local_path + "RESULTS/bowtie2/{sample}.notAlign.R%.fastq.gz",
        paired           = lambda wildcards: is_paired(
            wildcards.sample,
            checkpoints.check_samplesheet.get(**wildcards).output[0]
        )
    threads:
        multi_threads_nbr
    shell:
        """
        if [ "{params.paired}" = "True" ]; then
            reads="-1 {input.r1} -2 {input.r2}"
            out_reads="--un-conc-gz {params.unaligned_prefix}"
        else
            reads="-U {input.r1}"
            out_reads="--un-gz {params.unaligned_prefix}.1.gz"
        fi

        bowtie2 \
            -x {input.index} \
            --threads {threads} \
            --end-to-end \
            --no-unal \
            --no-hd \
            ${{reads}} \
            ${{out_reads}} \
            -S {output.sam} 2>> {log}

        if [ "{params.paired}" = "False" ]; then
            touch {output.r2}
        fi
        """

rule samtools:
    input:
        sam_hisat2  = local_path + "RESULTS/hisat2/{sample}.hisat2.sam" if config["aligner"] in ["both", "hisat2"] else [],
        sam_bowtie2 = local_path + "RESULTS/bowtie2/{sample}.bowtie2.sam" if config["aligner"] in ["both", "bowtie2"] else []
    output:
        bam = local_path + "RESULTS/BAM/{sample}.bam"
    log:
        view_header = logs_path + "samtools_filter/{sample}.grep.log",
        view_core   = logs_path + "samtools_filter/{sample}.grep_core.log",
        ZS_filter   = logs_path + "samtools_filter/{sample}.NH_filter.log",
        XS_filter   = logs_path + "samtools_filter/{sample}.XS_filter.log",
        XM_filter   = logs_path + "samtools_filter/{sample}.XM_filter.log",
        view_bam    = logs_path + "samtools_filter/{sample}.view_bam.log",
        sort_bam    = logs_path + "samtools_filter/{sample}.sort_bam.log",
        rm          = logs_path + "samtools_filter/{sample}.rm.log"
    benchmark:
        local_path + "benchmarks/samtools_filter/{sample}.benchmark.txt"
    resources:
        mem_mb = round(mem_mb_resources / 3)
    params:
        sam = local_path + "RESULTS/" + folder_alignment + "/{sample}.sam"
    threads:
        multi_threads_nbr
    shell:
        """
        if [ -z "{input.sam_bowtie2}" ]; then
            samtools view -H {input.sam_hisat2} 2> {log.view_header} 1> {params.sam}
            samtools view {input.sam_hisat2} 2> {log.view_core} | \
                grep -v 'ZS:i:' 2> {log.ZS_filter} | \
                egrep -vi 'XM:i:[2-9]' 2> {log.XM_filter} \
                1>> {params.sam}
        elif [ -z "{input.sam_hisat2}" ]; then
            samtools view -H {input.sam_bowtie2} 2> {log.view_header} 1> {params.sam}
            grep -v 'XS:i:' {input.sam_bowtie2} 2> {log.XS_filter} | \
                egrep -vi 'XM:i:[2-9]' 2>> {log.XM_filter} \
                1>> {params.sam}
        else
            samtools view -H {input.sam_hisat2} 2> {log.view_header} 1> {params.sam}
            samtools view {input.sam_hisat2} 2> {log.view_core} | \
                grep -v 'ZS:i:' 2> {log.ZS_filter} | \
                egrep -vi 'XM:i:[2-9]' 2> {log.XM_filter} \
                1>> {params.sam}
            grep -v 'XS:i:' {input.sam_bowtie2} 2> {log.XS_filter} | \
                egrep -vi 'XM:i:[2-9]' 2>> {log.XM_filter} \
                1>> {params.sam}
        fi

        samtools view -@ {threads} -F 3844 -q 1 -h -b {params.sam} 2> {log.view_bam} | \
            samtools sort -@ {threads} -o {output.bam} 2> {log.sort_bam}

        rm -rf {params.sam} 2> {log.rm}
        """

rule STAR_align:
    input:
        index = lambda wildcards: local_path + "RESULTS/annex_database/index/STAR/" + os.path.splitext(os.path.basename(get_fasta(wildcards)))[0] + "/genomeParameters.txt",
        r1    = lambda wildcards: (local_path + "RESULTS/trimgalore/{sample}_R1_trimgalore.fastq.gz"
            if config["skip_depletion"] and not config["skip_trimming"] and config["trimmer"] == "trimgalore"
            else (
                local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R1.fastq.gz"
                if not config["skip_depletion"] and not config["skip_trimming"] and config["depletion_tool"] == "sortMeRNA"
                else (
                    local_path + "RESULTS/bowtie2_depletion/{sample}_R1.fastq.gz"
                    if not config["skip_depletion"] and not config["skip_trimming"] and config["depletion_tool"] == "bowtie2"
                    else find_fastq_path(wildcards)[0]))
            ),
        r2    = lambda wildcards: (
            local_path + "RESULTS/trimgalore/{sample}_R2_trimgalore.fastq.gz"
            if is_paired(wildcards.sample, checkpoints.check_samplesheet.get(**wildcards).output[0]) 
            and config["skip_depletion"] and not config["skip_trimming"] and config["trimmer"] == "trimgalore"
            else (
                local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R2.fastq.gz"
                if is_paired(wildcards.sample,
                    checkpoints.check_samplesheet.get(**wildcards).output[0])
                and not config["skip_depletion"] and not config["skip_trimming"] and config["depletion_tool"] == "sortMeRNA"
                else (
                    local_path + "RESULTS/bowtie2_depletion/{sample}_R2.fastq.gz"
                    if is_paired(wildcards.sample, checkpoints.check_samplesheet.get(**wildcards).output[0])
                    and not config["skip_depletion"] and not config["skip_trimming"] and config["depletion_tool"] == "bowtie2"
                    else (
                        find_fastq_path(wildcards)[1]
                        if is_paired(wildcards.sample, checkpoints.check_samplesheet.get(**wildcards).output[0])
                        and config["skip_depletion"] and config["skip_trimming"]
                        else []
                    )
                )
            )
        )
    output:
        bam = local_path + "RESULTS/" + folder_alignment + "/{sample}.bam"
    log:
        err = logs_path + "STAR/{sample}_align.err",
        out = logs_path + "STAR/{sample}_align.out"
    benchmark:
        local_path + "benchmarks/STAR/{sample}.benchmark.txt"
    params:
        index_dir = lambda wildcards: local_path + "RESULTS/annex_database/index/STAR/" + os.path.splitext(os.path.basename(get_fasta(wildcards)))[0] + "/",
        out_dir   = local_path + "RESULTS/STAR/",
        prefix    = "{sample}_",
        tmp_dir   = local_path + "RESULTS/STAR/{sample}_tmp/"
    threads:
        multi_threads_nbr
    shell:
        """
        if [ ! -d {params.out_dir} ]; then
            mkdir -p {params.out_dir}
        fi

        if [ -n "{input.r2}" ]; then
            reads="{input.r1} {input.r2}"
        else
            reads="{input.r1}"
        fi

        STAR \
            --genomeDir {params.index_dir} \
            --outFileNamePrefix {params.out_dir}{params.prefix} \
            --outSAMtype BAM Unsorted \
            --readFilesCommand zcat \
            --outFilterMismatchNmax 1 \
            --outFilterMultimapNmax 10 \
            --alignEndsType EndToEnd \
            --readFilesIn ${{reads}} \
            --runThreadN {threads} \
            --outBAMsortingBinsN 200 \
            --limitBAMsortRAM 10000000000 \
            1> {log.out} 2> {log.err}

        cat {params.out_dir}{params.prefix}Log.out 1>> {log.out} 2>> {log.err}
        cat {params.out_dir}{params.prefix}Log.final.out 1>> {log.out} 2>> {log.err}
        cat {params.out_dir}{params.prefix}Log.progress.out 1>> {log.out} 2>> {log.err}
        rm {params.out_dir}{params.prefix}Log*out 2>> {log.err}
        samtools sort -@ {threads} {params.out_dir}{params.prefix}Aligned.out.bam -o {output.bam} 2>> {log.err} 1>> {log.out}
        """

