rule DESeq2_analysis_transcript:
    input:
        by_transcript = local_path + "RESULTS/DESeq2_" + config['gff_cds_feature'] + "/{sample_type}/DESeq2_by_transcript/count_matrix_by_transcript.csv"
    output:
        complete = local_path + "RESULTS/DESeq2_" + config['gff_cds_feature'] + "/{sample_type}/DESeq2_by_transcript/transcript_complete_" + REFERENCE_COND + "-{cond}.csv",
        up       = local_path + "RESULTS/DESeq2_" + config['gff_cds_feature'] + "/{sample_type}/DESeq2_by_transcript/transcript_up_" + REFERENCE_COND + "-{cond}.csv",
        down     = local_path + "RESULTS/DESeq2_" + config['gff_cds_feature'] + "/{sample_type}/DESeq2_by_transcript/transcript_down_" + REFERENCE_COND + "-{cond}.csv",
        report   = local_path + "RESULTS/DESeq2_" + config['gff_cds_feature'] + "/{sample_type}/DESeq2_by_transcript/" + config['project_name'] + "_" + REFERENCE_COND + "-{cond}.Final_report.html"
    log:
        deseq2 = logs_path + "DESeq2_analysis_transcript/{sample_type}/DESeq2_analysis_" + REFERENCE_COND + "-{cond}.log"
    benchmark:
        local_path + "benchmarks/DESeq2_analysis_transcript/{sample_type}/DESeq2_analysis.benchmark_" + REFERENCE_COND + "-{cond}.txt"
    params:
        reportPath       = local_path + "RESULTS/DESeq2_" + config['gff_cds_feature'] + "/{sample_type}/DESeq2_by_transcript/",
        reportName       = config['project_name'] + "_" + REFERENCE_COND + "-{cond}.Final_report.html",
        refCond          = REFERENCE_COND,
        other_cond       = "{cond}",
        padj_threshold   = float(config["p-val"]),
        log2fc_threshold = int(config["logFC"]),
        feature_type     = config['gff_cds_feature'],
        working_dir      = local_path,
        path_function    = ribodoc_tools + "differential_analysis/DESeq2_analysis_functions.R"
    shell:
        "Rscript -e \""
        "rmarkdown::render("
        "  '" + ribodoc_tools + "differential_analysis/DESeq2_analysis_by_transcript.Rmd',"
        "  output_format = 'html_document',"
        "  output_file   = '{params.reportName}',"
        "  output_dir    = '{params.reportPath}',"
        "  knit_root_dir = '{params.working_dir}',"
        "  intermediates_dir = '{params.reportPath}',"
        "  params = list("
        "    working_dir   = '{params.working_dir}',"
        "    path_function = '{params.path_function}',"
        "    refCond       = '{params.refCond}',"
        "    other_cond    = '{params.other_cond}',"
        "    padj          = {params.padj_threshold},"
        "    log2fc        = {params.log2fc_threshold},"
        "    seq_type      = '{wildcards.sample_type}',"
        "    feature       = '{params.feature_type}'"
        "  )"
        ")\" 2> {log.deseq2}"

rule bamDivision:
    input:
        bam = local_path + "RESULTS/" + folder_alignment + "_transcripts/{sample}.transcripts.bam",
    output:
        bam = local_path + "RESULTS/bamDivision/{sample}.{kmer}.uniq.sort.bam",
        bai = local_path + "RESULTS/bamDivision/{sample}.{kmer}.uniq.sort.bam.bai"
    log:
        logs_path + "quality_controls_bamDivision/{sample}.{kmer}.BamDivision.log"
    benchmark:
        local_path + "benchmarks/quality_controls_bamDivision/{sample}.{kmer}.benchmark.txt"
    threads:
        multi_threads_nbr
    params:
        sample_names = "{sample}",
        read_length  = "{kmer}"
    shell:
        "bash " + ribodoc_tools + "trip/BamDivision.sh"
        " -N {params.sample_names}"
        " -l {params.read_length}"
        " -B {input.bam}"
        " -T {threads}"
        " -o " + local_path + "RESULTS/ 2> {log}"

rule bedcount:
    input:
        bam   = local_path + "RESULTS/bamDivision/{sample}.{kmer}.uniq.sort.bam",
        bai   = local_path + "RESULTS/bamDivision/{sample}.{kmer}.uniq.sort.bam.bai",
        fasta = lambda wildcards: local_path + "RESULTS/annex_database/index/rsem/" + os.path.splitext(os.path.basename(get_fasta(wildcards)))[0] + "_transcripts/genome.transcripts.fa"
    output:
        sequenceBedCount          = local_path + "RESULTS/sequenceBedCount/{sample}.{kmer}.count.sequence.bed",
        readsLengthRepartitionBed = temp(local_path + "RESULTS/readsLengthRepartition/{sample}.{kmer}.bed"),
        bed                       = temp(local_path + "RESULTS/bedCount/{sample}.{kmer}.count.bed")
    log:
        logs_path + "bedcount/{sample}.{kmer}.readsLengthRepartition.log"
    benchmark:
        local_path + "benchmarks/bedcount/{sample}.{kmer}.benchmark.txt"
    params:
        sample_names = "{sample}",
        read_length  = "{kmer}"
    shell:
        "bash " + ribodoc_tools + "trip/readsLengthRepartition.sh"
        " -N {params.sample_names}"
        " -l {params.read_length}"
        " -F {input.fasta}"
        " -D " + local_path + "RESULTS/bamDivision/"
        " -O " + local_path + "RESULTS/ 2> {log}"

rule codon_occupancy:
    input:
        psite_table = local_path + "RESULTS/ribowaltz/psite_offset.tsv",
        seqbedCount = lambda wildcards: expand(
            rules.bedcount.output.readsLengthRepartitionBed,
            sample=get_sample(wildcards),
            kmer=LENGTHS
        )
    output:
        mean_codon_all_reads        = local_path + "RESULTS/codon_occupancy/" + config['site'] + "site/" + REFERENCE_COND + "_riboseq_vs_{cond}_riboseq_mean_by_codon_all_reads.tiff",
        mean_aa_all_reads           = local_path + "RESULTS/codon_occupancy/" + config['site'] + "site/" + REFERENCE_COND + "_riboseq_vs_{cond}_riboseq_mean_by_amino-acid_all_reads.tiff",
        norm_counts_cond_aa         = local_path + "RESULTS/codon_occupancy/" + config['site'] + "site/" + REFERENCE_COND + "_riboseq_vs_{cond}_riboseq_normalized_counts_by_condition_by_aa.csv",
        norm_counts_cond_codon      = local_path + "RESULTS/codon_occupancy/" + config['site'] + "site/" + REFERENCE_COND + "_riboseq_vs_{cond}_riboseq_normalized_counts_by_condition_by_codon.csv",
        percentage_aa_all_reads     = local_path + "RESULTS/codon_occupancy/" + config['site'] + "site/" + REFERENCE_COND + "_riboseq_vs_{cond}_riboseq_percentage_by_amino-acid_all_reads.csv",
        percentage_cond_all_reads   = local_path + "RESULTS/codon_occupancy/" + config['site'] + "site/" + REFERENCE_COND + "_riboseq_vs_{cond}_riboseq_percentage_by_condition_all_reads.csv",
        percentage_sample_all_reads = local_path + "RESULTS/codon_occupancy/" + config['site'] + "site/" + REFERENCE_COND + "_riboseq_vs_{cond}_riboseq_percentage_by_sample_all_reads.csv",
    log:
        rscript = logs_path + "codon_occupancy/" + REFERENCE_COND + "_vs_{cond}_Rscript.log"
    benchmark:
        local_path + "benchmarks/codon_occupancy/" + REFERENCE_COND + "_vs_{cond}_benchmark.txt"
    params:
        condition  = "{cond}",
        min_length = config["RPFLength_min"],
        max_length = config["RPFLength_max"]
    shell:
        "Rscript " + ribodoc_tools + "codon_occupancy/Occupancy_all.R"
        " -O {input.psite_table}"
        " -F " + ribodoc_tools + "codon_occupancy/"
        " -N " + REFERENCE_COND +
        " -n {params.condition}"
        " -r 0"
        " -m {params.min_length}"
        " -M {params.max_length}"
        " -e " + config['elongation'] +
        " -s " + config['site'] +
        " -f TRUE"
        " -p " + local_path + "RESULTS/sequenceBedCount/"
        " -o " + local_path + "RESULTS/codon_occupancy/"
        " 2> {log.rscript}"

checkpoint periodicity_graph:
    input:
        metaprofile = ribowaltz_outputs
    output:
        rgb_graph = local_path + "RESULTS/periodicity_-" + str(config['window_utr']) + "+" + str(config['window_cds']) + "/{sample}.transcripts/length{kmer}_start.tiff"
    log:
        rscript = logs_path + "periodicity_rgb/periodicity_{sample}_{kmer}.log"
    benchmark:
        local_path + "benchmarks/periodicity_rgb/benchmark_{sample}_{kmer}.txt"
    shell:
        "Rscript " + ribodoc_tools + "ribowaltz/change_riboWaltz_periodicity_graphs_to_RGB_by_length.R -w " + local_path + " 2> {log.rscript}"