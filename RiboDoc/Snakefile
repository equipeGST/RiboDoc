rule htseqcount_cds:
    input:
        gff = lambda wildcards: local_path + "RESULTS/annex_database/NamedCDS_" + os.path.splitext(os.path.basename(get_gff(wildcards)))[0] + ".gff3",
        bam = local_path + "RESULTS/" + folder_alignment + "/{sample}.bam",
    output:
        htseq_table = local_path + "RESULTS/htseq_count/{sample}." + config["gff_cds_feature"] + ".tsv"
    log:
        echo       = logs_path + "htseq_count/cds/{sample}.echo.log",
        sed        = logs_path + "htseq_count/cds/{sample}.sed.log",
        htseqcount = logs_path + "htseq_count/cds/{sample}.htseqcount.log",
        head       = logs_path + "htseq_count/cds/{sample}.head.log",
        awk        = logs_path + "htseq_count/cds/{sample}.awk.log",
        rm         = logs_path + "htseq_count/cds/{sample}.rm.log"
    benchmark:
        local_path + "benchmarks/htseq_count/cds/{sample}.benchmark.txt"
    params:
        gff_basename     = lambda wildcards: os.path.splitext(os.path.basename(get_gff(wildcards)))[0],
        tmp_file         = local_path + "RESULTS/htseq_count/{sample}." + config["gff_cds_feature"] + "_tmp.tsv",
        cds_feature      = config["gff_cds_feature"],
        parent_attribut  = config["gff_parent_attribut"],
        htseq_additional = config["gff_name_attribut"],
    threads:
        multi_threads_nbr
    shell:
        """
        echo -e "id\tname\t{wildcards.sample}" 2> {log.echo} > {output.htseq_table}

        htseq-count \
            -n {threads} \
            -f bam \
            -t {params.cds_feature} \
            -i {params.parent_attribut} \
            --additional-attr {params.htseq_additional} \
            -m intersection-strict \
            --nonunique fraction \
            {input.bam} {input.gff} \
            2> {log.htseqcount} > {params.tmp_file}

        head -n -5 {params.tmp_file} 2> {log.head} | \
            awk -F '\t+' '{{if($3 >= 0) {{print($0)}} else {{printf("%s\\tNA\\t%s\\n",$1,$2)}}}}' 2> {log.awk} >> {output.htseq_table}

        rm {params.tmp_file} 2> {log.rm}
        """

