rule filter_by_5UTR:
    input:
        gff_namedCDS = local_path + "RESULTS/annex_database/NamedCDS_{gff_basename}.gff3"
    output:
        gff_5UTR_filtered   = temp(local_path + "RESULTS/annex_database/gff_5UTR_filtered_{gff_basename}.gff3"),
        gff_features        = local_path + "RESULTS/annex_database/gff_features_counts_{gff_basename}.txt"
    log:
        logs_path + "filter_by_5UTR/filtering_{gff_basename}.log"
    benchmark:
        local_path + "benchmarks/filter_by_5UTR/filtering_{gff_basename}.benchmark.txt"
    params:
        annex_path = local_path + "RESULTS/annex_database/"
    shell:
        "bash " + ribodoc_tools + "others/filter_5UTR.sh -g {input.gff_namedCDS} -o {output.gff_5UTR_filtered} -O {output.gff_features} -p {params.annex_path} -r " + config["gff_mRNA_feature"] + " -u " + config["gff_5UTR_feature"] + " -t " + utr_threshold + " 2> {log}"

rule ORFget:
    input:
        fasta   = lambda wildcards: get_fasta(wildcards),
        gff     = lambda wildcards: local_path + "RESULTS/annex_database/gff_5UTR_filtered_" + os.path.splitext(os.path.basename(get_gff(wildcards)))[0] + ".gff3"
    output:
        fasta   = local_path + "RESULTS/annex_database/transcriptome_elongated.nfasta",
        gff     = local_path + "RESULTS/annex_database/transcriptome_elongated.gff"
    log:
        orf_get = logs_path + "ORFget/orf_get.log"
    benchmark:
        local_path + "benchmarks/ORFget/ORFget.benchmark.txt"
    params:
        path = local_path + "RESULTS/annex_database/transcriptome"
    shell:
        "python3 " + ribodoc_tools + "orfget/ORFget.py -fna {input.fasta} -gff {input.gff} -features_include " + config['gff_cds_feature'] + " -name_attribute " + config['gff_name_attribut'] + " -o {params.path} -type nucl -elongate 50 -check 2> {log.orf_get}"

rule transcriptome_construction_gtf:
    input:
        fasta   = local_path + "RESULTS/annex_database/transcriptome_elongated.nfasta",
        gff     = local_path + "RESULTS/annex_database/transcriptome_elongated.gff"
    output:
        fasta   = local_path + "RESULTS/annex_database/transcriptome_elongated.exons_{fasta_basename}.fa",
        gtf     = local_path + "RESULTS/annex_database/transcriptome_elongated.exons_{fasta_basename}.gtf"
    log:
        samtools_index  = logs_path + "transcriptome_construction_gtf/samtools_index_{fasta_basename}.log",
        gffread_gtf     = logs_path + "transcriptome_construction_gtf/gffread_{fasta_basename}.log",
        sed             = logs_path + "transcriptome_construction_gtf/sed_{fasta_basename}.log",
        awk             = logs_path + "transcriptome_construction_gtf/awk_{fasta_basename}.log"
    benchmark:
        local_path + "benchmarks/transcriptome_construction_gtf/transcriptome_construction_gtf_{fasta_basename}.benchmark.txt"
    params:
        tmp_gtf = local_path + "RESULTS/annex_database/transcriptome_elongated.exons_tmp.gtf"
    shell:
        "samtools faidx {input.fasta} 2> {log.samtools_index} ;"
        "gffread -F -T -w {output.fasta} -o {params.tmp_gtf} -g {input.fasta} {input.gff} 2> {log.gffread_gtf} ;"
        "sed -i 's/description[^\;]*\;//' {params.tmp_gtf} 2>> {log.sed} ;"
        "sed -i 's/\\t[A-Z]*[_]*gene_segment\\t/\\ttranscript\\t/' {params.tmp_gtf} 2>> {log.sed} ;"
        """awk -F '\\t' '{{if(NF<=9) {{print($0);}} else {{for(field=1;field<9;field++) {{printf("%s\\t",$field);}} for(field=9;field<=NF;field++) {{printf("%s ",$field);}} printf("\\n");}}}}' {params.tmp_gtf} > {output.gtf} 2>> {log.awk} ;"""
        "rm -f {params.tmp_gtf} ;"
        "sed -i 's/\\s$//' {output.gtf} 2>> {log.sed} ;"

rule trimgalore:
    input:
        fastq_files = lambda wildcards: find_fastq_path(wildcards),
    output:
        r1 = local_path + "RESULTS/trimgalore/{sample}_R1_trimgalore.fastq.gz",
        r2 = local_path + "RESULTS/trimgalore/{sample}_R2_trimgalore.fastq.gz"
    log:
        trimming = logs_path + "trimgalore/{sample}_trimgalore.log",
    benchmark:
        local_path + "benchmarks/trimgalore/{sample}.benchmark.txt"
    resources:
        mem_mb = mem_mb_resources
    threads:
        multi_threads_nbr
    params:
        paired = lambda wildcards: is_paired(
            wildcards.sample,
            checkpoints.check_samplesheet.get(**wildcards).output[0]
        ),
        min_len = lambda wildcards: (
            config['RPFLength_min']
            if get_sample_type(wildcards.sample) == "riboseq"
            else (config['mRNALength_min'] if config['mRNALength_min'] != "" else [])
        ),
        max_len = lambda wildcards: (
            config['RPFLength_max']
            if get_sample_type(wildcards.sample) == "riboseq"
            else (config['mRNALength_max'] if config['mRNALength_max'] not in ["", None] else [])
        ),
        skip_trimming    = config['skip_trimming'],
        outdir           = local_path + "RESULTS/trimgalore/",
        adapter_sequence = lambda wildcards: get_adapter(wildcards),
    shell:
        """
        adapter_sequence=({params.adapter_sequence});
        a1="${{adapter_sequence[0]}}";
        a2="${{adapter_sequence[1]:-""}}";

        min_len={params.min_len};
        max_len={params.max_len};
        files=({input.fastq_files});
        r1=${{files[0]}};
        r2=${{files[1]:-""}};
        if [ -n "${{max_len}}" ] && [ "${{max_len}}" != "None" ]; then
            len_args="--length ${{min_len}} --max_length ${{max_len}}"
        else
            len_args="--length ${{min_len}}"
        fi

        if [ "{params.skip_trimming}" = "True" ]; then
            trim=""
        else
            if [ "{params.paired}" = "True" ]; then
                trim="-a ${{a1}} -a2 ${{a2}}"
            else
                trim="-a ${{a1}}"
            fi
        fi

        if [ "{params.paired}" = "True" ]; then
            mode="--paired ${{r1}} ${{r2}}"
        else
            mode="${{r1}}"
        fi

        trim_galore ${{trim}} -e 0.125 -j {threads} --max_n 1 ${{len_args}} -o {params.outdir} ${{mode}} --no_report_file &> {log.trimming}

        if [ "{params.paired}" = "True" ]; then
            mv "{params.outdir}$(basename "$r1" .fastq.gz)_val_1.fq.gz" "{output.r1}"
            mv "{params.outdir}$(basename "$r2" .fastq.gz)_val_2.fq.gz" "{output.r2}"
        else
            mv "{params.outdir}$(basename "$r1" .fastq.gz)_trimmed.fq.gz" "{output.r1}"
            touch "{output.r2}"
        fi
        """

rule fastqc_after_trimming:
    input:
        r1 = local_path + "RESULTS/trimgalore/{sample}_R1_trimgalore.fastq.gz",
        r2 = lambda wildcards: (
            local_path + "RESULTS/trimgalore/{sample}_R2_trimgalore.fastq.gz"
            if is_paired(wildcards.sample,
                checkpoints.check_samplesheet.get(**wildcards).output[0])
            else []
        )
    output:
        r1_zip  = local_path + "RESULTS/fastqc/after_trimming/{sample}_R1_fastqc.zip",
        r1_html = local_path + "RESULTS/fastqc/after_trimming/{sample}_R1_fastqc.html",
        r2_zip  = local_path + "RESULTS/fastqc/after_trimming/{sample}_R2_fastqc.zip",
        r2_html = local_path + "RESULTS/fastqc/after_trimming/{sample}_R2_fastqc.html"
    log:
        logs_path + "fastqc_after_trimming/{sample}.log"
    benchmark:
        local_path + "benchmarks/fastqc_after_trimming/{sample}.benchmark.txt"
    params:
        paired = lambda wildcards: is_paired(
            wildcards.sample,
            checkpoints.check_samplesheet.get(**wildcards).output[0]
        ),
        outdir = local_path + "RESULTS/fastqc/after_trimming/tmp_fastqc_{sample}"
    shell:
        """
        mkdir -p {params.outdir}

        r1={input.r1}
        r2={input.r2}

        fastqc $r1 --outdir {params.outdir} >> {log} 2>&1
        mv {params.outdir}/$(basename $r1 .fastq.gz)_fastqc.zip {output.r1_zip}
        mv {params.outdir}/$(basename $r1 .fastq.gz)_fastqc.html {output.r1_html}

        if [ "{params.paired}" = "True" ] && [ -n "$r2" ]; then
            fastqc $r2 --outdir {params.outdir} >> {log} 2>&1
            mv {params.outdir}/$(basename $r2 .fastq.gz)_fastqc.zip {output.r2_zip}
            mv {params.outdir}/$(basename $r2 .fastq.gz)_fastqc.html {output.r2_html}
        else
            touch {output.r2_zip} {output.r2_html}
        fi

        rm -r {params.outdir}
        """

rule sortMeRNA:
    input:
        r1 = lambda wildcards: (local_path + "RESULTS/trimgalore/{sample}_R1_trimgalore.fastq.gz"
            if not config["skip_trimming"]
            else find_fastq_path(wildcards)[0]),
        r2 = lambda wildcards: (
            local_path + "RESULTS/trimgalore/{sample}_R2_trimgalore.fastq.gz"
            if is_paired(wildcards.sample,
                checkpoints.check_samplesheet.get(**wildcards).output[0]) and not config["skip_trimming"]
            else (
                find_fastq_path(wildcards)[1] if config["skip_trimming"] and is_paired(wildcards.sample, checkpoints.check_samplesheet.get(**wildcards).output[0])
                else []
            )
        ),
        rrna = config['rRNA']
    output:
        r1_aligned     = local_path + "RESULTS/sortMeRNA/aligned/{sample}_R1.fastq.gz",
        r2_aligned     = local_path + "RESULTS/sortMeRNA/aligned/{sample}_R2.fastq.gz",
        r1_non_aligned = local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R1.fastq.gz",
        r2_non_aligned = local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R2.fastq.gz"
    log:
        logs_path + "sortmerna/{sample}.log"
    benchmark:
        local_path + "benchmarks/sortmerna/{sample}.benchmark.txt"
    params:
        workdir   = local_path + "RESULTS",
        paired    = lambda wildcards: is_paired(
            wildcards.sample,
            checkpoints.check_samplesheet.get(**wildcards).output[0]
        ),
        save_rRNA = config['save_rRNA']
    threads:
        multi_threads_nbr
    shell:
        """
        if [ -n "{input.r2}" ]; then
            echo "Paired-end sample detected. Running sortMeRNA with both R1 and R2." >> {log} 2>&1
            reads="--reads {input.r1} --reads {input.r2} --out2"
        else
            echo "Single-end sample detected. Running sortMeRNA with R1 only." >> {log} 2>&1
            reads="--reads {input.r1}"
        fi

        mkdir -p "{params.workdir}/annex_database/index/sortMeRNA/"

        sample_name="{wildcards.sample}"
        sortmerna \\
            --ref {input.rrna} \\
            --threads {threads} \\
            $reads \\
            --paired_out \\
            --fastx \\
            --aligned {params.workdir}/sortMeRNA/aligned/${{sample_name}} \\
            --other {params.workdir}/sortMeRNA/non_aligned/${{sample_name}} \\
            --workdir {params.workdir}/ \\
            --idx-dir {params.workdir}/annex_database/index/sortMeRNA/ \\
            --kvdb {params.workdir}/sortMeRNA/${{sample_name}}/kvdb/ \\
            --readb {params.workdir}/sortMeRNA/${{sample_name}}/readb/ \\
            > {log} 2>&1

        if [ -n "{input.r2}" ]; then
            mv {params.workdir}/sortMeRNA/non_aligned/${{sample_name}}_fwd.fq.gz {output.r1_non_aligned}
            mv {params.workdir}/sortMeRNA/non_aligned/${{sample_name}}_rev.fq.gz {output.r2_non_aligned}
            if [ {params.save_rRNA} = "True" ]; then
                mv {params.workdir}/sortMeRNA/aligned/${{sample_name}}_fwd.fq.gz {output.r1_aligned}
                mv {params.workdir}/sortMeRNA/aligned/${{sample_name}}_rev.fq.gz {output.r2_aligned}
            else
                touch {output.r1_aligned} {output.r2_aligned}   # <-- AJOUT
            fi
        else
            if [ {params.save_rRNA} = "True" ]; then
                mv {params.workdir}/sortMeRNA/aligned/${{sample_name}}.fq.gz {output.r1_aligned}
                touch {output.r2_aligned}
            else
                touch {output.r1_aligned} {output.r2_aligned}   # <-- AJOUT
            fi
            mv {params.workdir}/sortMeRNA/non_aligned/${{sample_name}}.fq.gz {output.r1_non_aligned}
            touch {output.r2_non_aligned}
        fi

        rm -rf {params.workdir}/sortMeRNA/${{sample_name}}/
    """

rule bowtie2_index_depletion:
    input:
        rrna = config['rRNA']
    output:
        index = local_path + "RESULTS/annex_database/index_files/outRNA_bowtie2.1.bt2"
    log:
        logs_path + "bowtie2_build_outRNA/bowtie2_build_outRNA.log"
    benchmark:
        local_path + "benchmarks/bowtie2_build_outRNA/bowtie2_build_outRNA.benchmark.txt"
    threads:
        multi_threads_nbr
    params:
        outNames = local_path + "RESULTS/annex_database/index_files/outRNA_bowtie2"
    shell:
        """
        bowtie2-build --threads {threads} {input.rrna} {params.outNames} &> {log}
        """

rule bowtie2_depletion:
    input:
        local_path + "RESULTS/annex_database/index_files/outRNA_bowtie2.1.bt2",
        r1 = lambda wildcards: (local_path + "RESULTS/trimgalore/{sample}_R1_trimgalore.fastq.gz"
            if not config["skip_trimming"]
            else find_fastq_path(wildcards)[0]),
        r2 = lambda wildcards: (
            local_path + "RESULTS/trimgalore/{sample}_R2_trimgalore.fastq.gz"
            if is_paired(wildcards.sample,
                checkpoints.check_samplesheet.get(**wildcards).output[0]) and not config["skip_trimming"]
            else (
                find_fastq_path(wildcards)[1] if config["skip_trimming"] and is_paired(wildcards.sample, checkpoints.check_samplesheet.get(**wildcards).output[0])
                else []
            )
        )
    output:
        r1 = local_path + "RESULTS/bowtie2_depletion/{sample}_R1.fastq.gz",
        r2 = local_path + "RESULTS/bowtie2_depletion/{sample}_R2.fastq.gz"
    log:
        logs_path + "bowtie2_depletion/{sample}.log"
    benchmark:
        local_path + "benchmarks/bowtie2_depletion/{sample}.benchmark.txt"
    params:
        index  = local_path + "RESULTS/annex_database/index_files/outRNA_bowtie2",
        unaligned_prefix = local_path + "RESULTS/bowtie2_depletion/{sample}_R%.fastq.gz",
    threads:
        multi_threads_nbr
    shell:
        """
        if [ -n "{input.r2}" ]; then
            echo "Paired-end sample detected. Running alignment with both R1 and R2." >> {log} 2>&1
            reads="-1 {input.r1} -2 {input.r2} --un-conc-gz {params.unaligned_prefix}"
        else
            echo "Single-end sample detected. Running alignment with R1 only." >> {log} 2>&1
            reads="-U {input.r1} --un-gz {output.r1}"
        fi

        bowtie2 -x {params.index} --threads {threads} $reads > /dev/null 2>> {log}

        if [ -z "{input.r2}" ]; then
            touch {output.r2}
        fi
        """

rule fastqc_after_depletion:
    input:
        r1 = local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R1.fastq.gz" if config["depletion_tool"] == "sortMeRNA" else local_path + "RESULTS/bowtie2_depletion/{sample}_R1.fastq.gz",
        r2 = lambda wildcards: (
            local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R2.fastq.gz"
            if is_paired(wildcards.sample, checkpoints.check_samplesheet.get(**wildcards).output[0]) and config["depletion_tool"] == "sortMeRNA"
            else (local_path + "RESULTS/bowtie2_depletion/{sample}_R2.fastq.gz" if config["depletion_tool"] == "bowtie2" else [])
        )
    output:
        r1_zip  = local_path + "RESULTS/fastqc/after_depletion/{sample}_R1_fastqc.zip",
        r1_html = local_path + "RESULTS/fastqc/after_depletion/{sample}_R1_fastqc.html",
        r2_zip  = local_path + "RESULTS/fastqc/after_depletion/{sample}_R2_fastqc.zip",
        r2_html = local_path + "RESULTS/fastqc/after_depletion/{sample}_R2_fastqc.html"
    log:
        logs_path + "fastqc_after_depletion/{sample}.log"
    benchmark:
        local_path + "benchmarks/fastqc_after_depletion/{sample}.benchmark.txt"
    params:
        paired = lambda wildcards: is_paired(wildcards.sample, checkpoints.check_samplesheet.get(**wildcards).output[0]),
        outdir = local_path + "RESULTS/fastqc/after_depletion/tmp_fastqc_{sample}"
    shell:
        """
        mkdir -p {params.outdir}

        r1={input.r1}
        r2={input.r2}

        fastqc $r1 --outdir {params.outdir} >> {log} 2>&1
        mv {params.outdir}/$(basename $r1 .fastq.gz)_fastqc.zip {output.r1_zip}
        mv {params.outdir}/$(basename $r1 .fastq.gz)_fastqc.html {output.r1_html}

        if [ "{params.paired}" = "True" ] && [ -n "$r2" ]; then
            fastqc $r2 --outdir {params.outdir} >> {log} 2>&1
            mv {params.outdir}/$(basename $r2 .fastq.gz)_fastqc.zip {output.r2_zip}
            mv {params.outdir}/$(basename $r2 .fastq.gz)_fastqc.html {output.r2_html}
        else
            touch {output.r2_zip} {output.r2_html}
        fi

        rm -r {params.outdir}
        """

rule STAR_index:
