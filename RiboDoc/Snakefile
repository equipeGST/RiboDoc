# ─────────────────────────────────────────────────────────────
# Helper functions
# ─────────────────────────────────────────────────────────────

def get_sample(wildcards):
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    samples = []
    with open(checkpoint_output, "r") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("sample"):
                continue
            parts = [p.strip() for p in line.split("\t")]  # Nettoie TOUTES les colonnes
            if len(parts) > 5 and parts[5]:
                samples.append(parts[0].strip())  # parts[0] est déjà nettoyé
    return samples

def get_sample_type(sample):
    if "_" not in sample:
        raise ValueError("Cannot infer sample type from {sample}")
    return sample.split("_", 1)[1].split(".", 1)[0]

def get_samples_by_type(wildcards, sample_type):
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    samples = []
    for line in open(checkpoint_output).read().strip().split("\n")[1:]:
        parts = [p.strip() for p in line.strip().split("\t")]
        if len(parts) > 5 and parts[5]:
            sample = parts[0]
            if get_sample_type(sample) == sample_type:
                samples.append(sample)
    return samples

def is_paired(sample, checkpoint_output):
    with open(checkpoint_output, "r") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("sample"):
                continue
            parts = [p.strip() for p in line.split("\t")]
            if parts[0] == sample:
                paired = len(parts) > 2 and parts[2] != ""
                return paired
    return False

def get_paired_nums(sample, checkpoint_output):
    return [1, 2] if is_paired(sample, checkpoint_output) else [1]

def align_transcript_outputs(wildcards):
    samples = get_sample(wildcards)
    riboseq_samples = [s for s in samples if get_sample_type(s) == "riboseq"]
    return expand(
        local_path + "RESULTS/" + folder_alignment + "_transcripts/{sample}.transcripts.bam",
        sample=riboseq_samples)

def extract_column(file, column_index):
    with open(file, "r") as f:
        lines = f.read().strip().split("\n")[1:]
        return [line.split("\t")[column_index] for line in lines]

def find_fastq_path(wildcards):
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    for line in open(checkpoint_output).read().strip().split("\n")[1:]:
        parts = [p.strip() for p in line.strip().split("\t")]
        if parts[0] == wildcards.sample:
            return [p for p in parts[1:3] if p != ""]
    return []

def get_adapter(wildcards):
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    for line in open(checkpoint_output).read().strip().split("\n")[1:]:
        parts = [p.strip() for p in line.strip().split("\t")]
        if parts[0] == wildcards.sample:
            if len(parts[5]) > 0:
                return parts[5:7]
            else:
                raise ValueError("Adapter sequence not found for sample {wildcards.sample}.")
    raise ValueError("Sample {wildcards.sample} not found in samplesheet.")

def samples_with_barcode(wildcards):
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    samples = []
    for line in open(checkpoint_output).read().strip().split("\n")[1:]:
        parts = [p.strip() for p in line.strip().split("\t")]
        if len(parts) > 3 and parts[3]:
            samples.append(parts[0])
    return samples

def get_barcode(wildcards):
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    i = 0
    for line in open(checkpoint_output).read().strip().split("\n")[1:]:
        parts = [p.strip() for p in line.strip().split("\t")]
        sample = get_sample(wildcards)[i]
        if parts[0] == sample:
            if len(parts[3]) > 0:
                return parts[3:5]
            else:
                return []
        i += 1
    return []

def get_fasta(wildcards):
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    i = 0
    for line in open(checkpoint_output).read().strip().split("\n")[1:]:
        parts = [p.strip() for p in line.strip().split("\t")]
        sample = get_sample(wildcards)[i]
        if parts[0] == sample:
            if len(parts[7]) > 0:
                return parts[7]
            else:
                raise ValueError("Annotation file (FASTA format) not found for sample {sample}.")
        i += 1
    raise ValueError("Sample {wildcards.sample} not found in samplesheet.")

def get_gff(wildcards):
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    i = 0
    for line in open(checkpoint_output).read().strip().split("\n")[1:]:
        parts = [p.strip() for p in line.strip().split("\t")]
        sample = get_sample(wildcards)[i]
        if parts[0] == sample:
            if len(parts[8]) > 0:
                return parts[8]
            else:
                raise ValueError("Annotation file (GFF/GTF format) not found for sample {wildcards.sample}.")
        i += 1
    raise ValueError("Sample {wildcards.sample} not found in samplesheet.")

def both_sample_types(wildcards):
    """Check if samplesheet contains both riboseq and rnaseq samples."""
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    samples = []
    for line in open(checkpoint_output).read().strip().split("\n")[1:]:
        parts = [p.strip() for p in line.strip().split("\t")]
        if len(parts) > 5 and parts[5]:
            samples.append(parts[0].strip())
    sample_types = set()
    for sample in samples:
        try:
            sample_types.add(get_sample_type(sample))
        except ValueError:
            continue
    return 'riboseq' in sample_types and 'rnaseq' in sample_types

