rule hisat2_align:
    input:
        index   = lambda wildcards: local_path + "RESULTS/annex_database/index/hisat2/{fasta_basename}",
        r1      = local_path + "RESULTS/trimgalore/{sample}_R1_trimgalore.fastq.gz" if config["skip_depletion"] == True else local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R1.fastq.gz", 
        r2      = (
            local_path + "RESULTS/trimgalore/{sample}_R2_trimgalore.fastq.gz"
            if config['paired_end'] and config["skip_depletion"]
            else (
                local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R2.fastq.gz"
                if config['paired_end'] and not config["skip_depletion"]
                else []))
    output:
        r1  = local_path + "RESULTS/hisat2/{sample}.notAlign.fastq.1.gz" if config['paired_end'] == True else local_path + "RESULTS/hisat2/{sample}.notAlign.fastq.gz",
        r2  = local_path + "RESULTS/hisat2/{sample}.notAlign.fastq.2.gz" if config['paired_end'] == True else [],
        sam = local_path + "RESULTS/hisat2/{sample}.hisat2.sam"
    log:
        logs_path + "hisat2/{sample}_align.log"
    benchmark:
        local_path + "benchmarks/hisat2/{sample}_align.benchmark.txt"
    params:
        fasta_basename  = lambda wildcards: os.path.splitext(os.path.basename(get_fasta(wildcards)))[0]
    threads:
        multi_threads_nbr
    shell:
        """
        if [ -n "{input.r2}" ]; then
            reads="-1 {input.r1} -2 {input.r2}"
            out_reads="--un-conc-gz"
        else
            reads="-U {input.r1}"
            out_reads="--un-gz"
        fi

        hisat2 \\
            -x {input.index} \\
            --threads {threads} \\
            --no-softclip \\
            --no-unal \\
            ${{reads}} \\
            ${{out_reads}} {output.r1} {output.r2} \\
            -S {output.sam} 2>> {log} ;
        """

rule bowtie2_align:
    input:
        index   = local_path + "RESULTS/annex_database/index/bowtie2/{fasta_basename}",
        r1      = local_path + "RESULTS/hisat2/{sample}.notAlign.fastq.1.gz" if config['paired_end'] == True else local_path + "RESULTS/hisat2/{sample}.notAlign.fastq.gz",
        r2      = local_path + "RESULTS/hisat2/{sample}.notAlign.fastq.2.gz" if config['paired_end'] == True else [],
    output:
        r1  = local_path + "RESULTS/bowtie2/{sample}.notAlign.fastq.1.gz" if config['paired_end'] == True else local_path + "RESULTS/bowtie2/{sample}.notAlign.fastq.gz",
        r2  = local_path + "RESULTS/bowtie2/{sample}.notAlign.fastq.2.gz" if config['paired_end'] == True else [],
        sam = local_path + "RESULTS/bowtie2/{sample}.bowtie2.sam"
    log:
        logs_path + "bowtie2/{sample}_align.log"
    benchmark:
        local_path + "benchmarks/bowtie2/{sample}_align.benchmark.txt"
    params:
        fasta_basename  = lambda wildcards: os.path.splitext(os.path.basename(get_fasta(wildcards)))[0]
    threads:
        multi_threads_nbr
    shell:
        """
        if [ -n "{input.r2}" ]; then
            reads="-1 {input.r1} -2 {input.r2}"
            out_reads="--un-conc-gz"
        else
            reads="-U {input.r1}"
            out_reads="--un-gz"
        fi

        bowtie2 \\
            -x {input.index} \\
            --threads {threads} \\
            --end-to-end \\
            --no-unal \\
            --no-hd \\
            ${{reads}} \\
