def get_sample_to_fasta_mapping(wildcards):
    checkpoint_output = checkpoints.check_samplesheet.get(**wildcards).output[0]
    mapping = {}
    with open(checkpoint_output, "r") as f:
        lines = f.read().strip().split("\n")[1:]  # Skip the header
        for line in lines:
            parts = line.split("\t")
            sample = parts[0]  # Assuming the sample name is in the first column
            fasta = os.path.splitext(os.path.basename(parts[6]))[0]  # Assuming FASTA is in column 7
            mapping[sample] = fasta
    return mapping

def index_STAR(wildcards):
    if config["aligner"] != "STAR":
        return []
    fasta_basename = os.path.splitext(os.path.basename(get_fasta(wildcards)))[0]
    return expand(
        local_path + "RESULTS/annex_database/index/STAR/{fasta_basename}/{suffix}",
        fasta=get_fasta(wildcards),
        fasta_basename=fasta_basename,
        suffix=["chrLength.txt", "chrName.txt", "chrStart.txt",
            "chrNameLength.txt", "genomeParameters.txt",
            "SAindex", "SA", "Log.out"])

def index_STAR_transcript(wildcards):
    if config["aligner"] != "STAR" or config["transcript_fasta"] != "":
        return []
    fasta_basename = os.path.splitext(os.path.basename(get_fasta(wildcards)))[0]
    return expand(
        local_path + "RESULTS/annex_database/index/rsem/{fasta_basename}_transcripts/{suffix}",
        fasta_basename=fasta_basename,
        fasta=get_fasta(wildcards),
        suffix=["chrLength.txt", "chrName.txt", "chrStart.txt", "chrNameLength.txt", "genomeParameters.txt", "SAindex", "SA", "Log.out"])

