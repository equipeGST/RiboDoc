                local_path + "RESULTS/sortMeRNA/non_aligned/{sample}_R2.fastq.gz"
                if is_paired(wildcards.sample,
                    checkpoints.check_samplesheet.get(**wildcards).output[0])
                and not config["skip_depletion"] and not config["skip_trimming"] and config["depletion_tool"] == "sortMeRNA"
                else (
                    local_path + "RESULTS/bowtie2_depletion/{sample}_R2.fastq.gz"
