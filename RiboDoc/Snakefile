def ribowaltz_outputs(wildcards):
    samples = get_sample(wildcards)
    if any(get_sample_type(s) == "riboseq" for s in samples):
        return [local_path + "RESULTS/ribowaltz/psite_offset.tsv"]
    return []

def translational_efficiency(wildcards):
    if not both_sample_types(wildcards):
        return []
    return expand(local_path + "RESULTS/anota2seq")

def periodicity_outputs(wildcards):
    samples = get_sample(wildcards)
    riboseq_samples = [s for s in samples if get_sample_type(s) == "riboseq"]
    window_suffix = "-" + str(config['window_utr']) + "+" + str(config['window_cds'])
    return expand(
        local_path + "RESULTS/periodicity_" + window_suffix + "/{sample}.transcripts/length{kmer}_start.tiff",
        sample=riboseq_samples,
        kmer=LENGTHS
    )

