checkpoint check_samplesheet:
    input:
        config["samplesheet"]
    output:
        local_path + "RESULTS/samplesheet.tsv"
    shell:
        "python3 {ribodoc_tools}others/check_samplesheet.py {input} {output}"

# NOTE: Snakemake does not allow lambda functions in output fields.
# Strategy: all rules declare static output paths for both R1 and R2.
# For single-end samples, R2 outputs are created as empty files via `touch`.
# The *_outputs functions above only request R2 files for paired samples,
# so rule all never expects real content in those touched files.

rule fastqc_before_trimming:
    input:
        fastq_files = lambda wildcards: find_fastq_path(wildcards)
    output:
        r1_zip  = local_path + "RESULTS/fastqc/before_trimming/{sample}_R1_fastqc.zip",
        r1_html = local_path + "RESULTS/fastqc/before_trimming/{sample}_R1_fastqc.html",
        r2_zip  = local_path + "RESULTS/fastqc/before_trimming/{sample}_R2_fastqc.zip",
        r2_html = local_path + "RESULTS/fastqc/before_trimming/{sample}_R2_fastqc.html"
    log:
        logs_path + "fastqc_before_trimming/{sample}.log"
    benchmark:
        local_path + "benchmarks/fastqc_before_trimming/{sample}.benchmark.txt"
    params:
        outdir = local_path + "RESULTS/fastqc/before_trimming/tmp_fastqc_{sample}",
        paired = lambda wildcards: is_paired(
            wildcards.sample,
            checkpoints.check_samplesheet.get(**wildcards).output[0]
        )
    shell:
        """
        mkdir -p {params.outdir}

        files=({input.fastq_files})
        r1=${{files[0]}}
        r2=${{files[1]:-""}}

        fastqc $r1 --outdir {params.outdir} >> {log} 2>&1
        mv {params.outdir}/$(basename $r1 .fastq.gz)_fastqc.zip {output.r1_zip}
        mv {params.outdir}/$(basename $r1 .fastq.gz)_fastqc.html {output.r1_html}

        if [ "{params.paired}" = "True" ] && [ -n "$r2" ]; then
            fastqc $r2 --outdir {params.outdir} >> {log} 2>&1
            mv {params.outdir}/$(basename $r2 .fastq.gz)_fastqc.zip {output.r2_zip}
            mv {params.outdir}/$(basename $r2 .fastq.gz)_fastqc.html {output.r2_html}
        else
            touch {output.r2_zip} {output.r2_html}
        fi

        rm -r {params.outdir}
        """

rule UMI_extract:
    input:
        fastq_files = lambda wildcards: find_fastq_path(wildcards)
    output:
        r1 = local_path + "RESULTS/UMI_tools/{sample}_umi_extract_R1.fastq.gz",
        r2 = local_path + "RESULTS/UMI_tools/{sample}_umi_extract_R2.fastq.gz"
    log:
        logs_path + "UMI_tools/{sample}_extract.log"
    benchmark:
        local_path + "benchmarks/UMI_tools/{sample}_extract.benchmark.txt"
    params:
        barcode = lambda wildcards: get_barcode(wildcards),
        paired  = lambda wildcards: is_paired(
            wildcards.sample,
            checkpoints.check_samplesheet.get(**wildcards).output[0]
        )
    shell:
        """
        files=({input.fastq_files})
        r1=${{files[0]}}
        r2=${{files[1]:-""}}

        r1_out={output.r1}
        r2_out={output.r2}

        barcode=({params.barcode});
        b1="${{barcode[0]}}";
        b2="${{barcode[1]:-""}}";

        if [ "{params.paired}" = "True" ] && [ -n "$r2" ]; then
            args="--stdin=${{r1}} --stdout=${{r1_out}} --read2-in=${{r2}} --read2-out=${{r2_out}}"
        else
            args="--stdin=${{r1}} --stdout=${{r1_out}}"
        fi

        if [ -n "$b2" ]; then
            bc_args="--bc-pattern=${{b1}} --bc-pattern2=${{b2}}"
        else
            bc_args="--bc-pattern=${{b1}}"
        fi

        umi_tools extract \
            ${{args}} \
            ${{bc_args}} \
            --log={log}

        if [ "{params.paired}" = "False" ]; then
            touch {output.r2}
        fi
        """

""" rule name_CDS:
