        # fastq_files = lambda wildcards: [local_path + f"RESULTS/{config['trimmer']}/{wildcards.sample}_trimmed.fastq.gz"]
    output:
        r1_zip  = local_path + "RESULTS/fastqc/after_trimming/{sample}_R1_fastqc.zip",
