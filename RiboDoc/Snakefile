                    else (
                        find_fastq_path(wildcards)[1]
                        if is_paired(wildcards.sample, checkpoints.check_samplesheet.get(**wildcards).output[0]) and config["skip_depletion"] and config["skip_trimming"]
                        else []
                    )
                )
            )
        )
    output:
        bam = local_path + "RESULTS/" + folder_alignment + "_transcripts/{sample}.transcripts.bam"
    log:
        err = logs_path + "STAR/{sample}_align_transcripts.err",
        out = logs_path + "STAR/{sample}_align_transcripts.out"
    benchmark:
        local_path + "benchmarks/STAR/{sample}.benchmark_transcripts.txt"
    params:
        out_dir = local_path + "RESULTS/STAR/",
        prefix  = "{sample}_transcripts.",
        tmp_dir = local_path + "RESULTS/STAR/{sample}_tmp/",
        index   = lambda wildcards: local_path + "RESULTS/annex_database/index/rsem/" + os.path.splitext(os.path.basename(get_fasta(wildcards)))[0] + "_transcripts/",
    threads:
        multi_threads_nbr
    shell:
        """
        if [ ! -d {params.out_dir} ]; then
            mkdir -p {params.out_dir}
        fi

        if [ -n "{input.r2}" ]; then
            reads="{input.r1} {input.r2}"
        else
            reads="{input.r1}"
        fi

        STAR \
            --quantMode TranscriptomeSAM \
            --genomeDir {params.index} \
            --outFileNamePrefix {params.out_dir}{params.prefix} \
            --sjdbGTFfile {input.gff} \
            --readFilesCommand zcat \
            --readFilesIn ${{reads}} \
            --runThreadN {threads} \
            --outSAMtype BAM Unsorted \
            --twopassMode Basic \
            --alignEndsType EndToEnd \
            --outFilterMultimapNmax 10 \
            --outFilterMismatchNmax 1 \
            --alignSJDBoverhangMin 1 \
            --outSAMattributes All \
            --outSAMstrandField intronMotif \
            1> {log.out} 2> {log.err}

        cat {params.out_dir}{params.prefix}Log.out 1>> {log.out} 2>> {log.err}
        cat {params.out_dir}{params.prefix}Log.final.out 1>> {log.out} 2>> {log.err}
        cat {params.out_dir}{params.prefix}Log.progress.out 1>> {log.out} 2>> {log.err}
        rm {params.out_dir}{params.prefix}Log*out 2>> {log.err}
        mv {params.out_dir}{params.prefix}Aligned.toTranscriptome.out.bam {output.bam} 2>> {log.err} 1>> {log.out}
        """

